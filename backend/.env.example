# ============================================================
# Tracelight — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values you need.
# The app works with NO values set — it runs in demo mode.
# ============================================================


# ------------------------------------------------------------
# OPTION A: Local LLM via Ollama (recommended — free, private)
# ------------------------------------------------------------
# 1. Install Ollama: https://ollama.com/download
# 2. Pull a model:   ollama pull llama3.2
# 3. Ollama starts automatically and listens on port 11434
#
# Uncomment and set:
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.2
#
# Other good models for this task (pick one):
#   llama3.2          ~2 GB  fast, great quality       (recommended)
#   llama3.1          ~4 GB  smarter, needs ~6 GB VRAM
#   mistral           ~4 GB  very fast, good JSON
#   qwen2.5:7b        ~4 GB  excellent at structured output
#   deepseek-r1:7b    ~4 GB  strong reasoning


# ------------------------------------------------------------
# OPTION B: LM Studio (GUI-based local LLM)
# ------------------------------------------------------------
# 1. Install LM Studio: https://lmstudio.ai
# 2. Download any GGUF model inside LM Studio
# 3. Start the local server from the "Local Server" tab (port 1234)
#
# Uncomment and set:
# LOCAL_LLM_URL=http://localhost:1234/v1
# LOCAL_LLM_MODEL=lmstudio-community/Meta-Llama-3.1-8B-Instruct-GGUF


# ------------------------------------------------------------
# Hugging Face Settings
# ------------------------------------------------------------
# Store downloaded LLM weights in a local models/ directory instead of global cache
HF_HOME=./models


# ------------------------------------------------------------
# OPTION C: OpenAI Cloud API
# ------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini


# ------------------------------------------------------------
# Database (SQLite by default — no setup needed)
# ------------------------------------------------------------
# DATABASE_URL=sqlite:///./ai_platform.db
# Swap for PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost/tracelight


# ------------------------------------------------------------
# Redis + Celery (only if USE_CELERY=true)
# ------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# USE_CELERY=false
